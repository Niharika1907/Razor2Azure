@page
@model CompanyWeb.Pages.Departments.CreateModel

<h2>Create Department</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Department.DepartmentName" class="control-label"></label>
        <input asp-for="Department.DepartmentName" class="form-control" />
        <span asp-validation-for="Department.DepartmentName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
