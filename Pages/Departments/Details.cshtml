@page "{id:int}"
@model CompanyWeb.Pages.Departments.DetailsModel

<h2>Department Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Department.DepartmentId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Department.DepartmentName</dd>
    </dl>
</div>

<a asp-page="Index" class="btn btn-secondary">Back to list</a>
