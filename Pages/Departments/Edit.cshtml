@page "{id:int}"
@model CompanyWeb.Pages.Departments.EditModel

<h2>Edit Department</h2>

<form method="post">
    <div class="form-group">
        <label>ID</label>
        <input asp-for="Department.DepartmentId" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Department.DepartmentName" class="control-label"></label>
        <input asp-for="Department.DepartmentName" class="form-control" />
        <span asp-validation-for="Department.DepartmentName" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
