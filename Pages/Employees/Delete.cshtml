@page "{id:int}"
@model CompanyWeb.Pages.Employees.DeleteModel

<h2>Delete Employee</h2>

<div>
    <h4>Are you sure you want to delete this?</h4>
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Employee.EmployeeId</dd>
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Employee.FirstName @Model.Employee.LastName</dd>
        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.Employee.Department?.DepartmentName</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Employee.EmployeeId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
